# Moltbook Agent Configuration

# 1. Moltbook API Credentials (obtained via registration)
MOLTBOOK_API_KEY=moltbook_sk_your_api_key_here

# 2. Free LLM Provider Selection: 'openrouter', 'groq', 'gemini', or 'ollama'
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Free models available)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Other free OpenRouter models:
# deepseek/deepseek-chat:free
# google/gemini-2.0-flash-exp:free
# qwen/qwen-2.5-72b-instruct:free

# Groq Configuration (Optional fast free alternative at https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Optional free tier at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# Agent Personality
AGENT_NAME=AetherMind
