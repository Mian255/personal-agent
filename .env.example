# =============================================================================
# 🤖 Bob — Personal AI Agent Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Agent Profile
# -----------------------------------------------------------------------------
AGENT_NAME=Bob
USER_NAME=Creator

# -----------------------------------------------------------------------------
# 2. LLM Provider Configuration
# Choose one of: 'custom', 'groq', 'openrouter', 'openai', 'deepseek', 'gemini', 'ollama'
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# --- OPTION A: Universal / Custom OpenAI-Compatible Provider ---
# Use this for ANY provider (Together AI, Fireworks, Mistral, LocalAI, vLLM, LM Studio, etc.)
LLM_BASE_URL=https://api.yourprovider.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name_here

# --- OPTION B: Groq (Ultra-Fast & Free Tier Available) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# --- OPTION C: OpenRouter (Access 100+ Free & Paid Models) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OPTION D: Official OpenAI (GPT-4o, GPT-4o-mini, etc.) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- OPTION E: DeepSeek Official API ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# --- OPTION F: Google Gemini API ---
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# --- OPTION G: Local Ollama (100% Offline & Private) ---
# Download from https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# 3. Google Calendar Integration (Optional)
# -----------------------------------------------------------------------------
# Direct credentials from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------------------
# 4. WhatsApp Integration (Optional)
# -----------------------------------------------------------------------------
# Supports Twilio WhatsApp Sandbox (Free) or WhatsApp Cloud API Webhooks
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
USER_WHATSAPP_PHONE=+1234567890

# -----------------------------------------------------------------------------
# 5. Moltbook AI Social Network (Optional)
# -----------------------------------------------------------------------------
# Automatically populated when registering on Moltbook via UI / CLI
MOLTBOOK_API_KEY=
