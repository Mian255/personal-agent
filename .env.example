# =============================================================================
# 🤖 Personal AI Agent Configuration (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Agent Profile
# -----------------------------------------------------------------------------
AGENT_NAME=Bob
USER_NAME=Creator

# -----------------------------------------------------------------------------
# 2. Database URL (Optional - Defaults to local SQLite data/agent.db)
# -----------------------------------------------------------------------------
# For free cloud persistence on Render/Railway/Fly.io, use a free Neon.tech or Supabase connection:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/agent_db

# -----------------------------------------------------------------------------
# 3. LLM Provider Configuration
# Choose one of: 'groq', 'openrouter', 'openai', 'deepseek', 'gemini', 'ollama', 'custom'
# -----------------------------------------------------------------------------
LLM_PROVIDER=

# --- OPTION A: Groq (Recommended - Ultra-Fast & Free Tier Available) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=
# --- OPTION B: OpenRouter (Access 100+ Free & Paid Models) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- OPTION C: Official OpenAI (GPT-4o, GPT-4o-mini, etc.) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- OPTION D: DeepSeek Official API ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# --- OPTION E: Google Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL

# --- OPTION F: Local Ollama (100% Offline & Private) ---
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# -----------------------------------------------------------------------------
# 4. Google Calendar Integration (Optional - Live 2-Way Sync)
# -----------------------------------------------------------------------------
# Create an OAuth 2.0 Web Client ID in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 5. WhatsApp Integration (Meta Cloud API & Twilio Supported)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta

# --- Meta Official WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Your Personal WhatsApp Number (with country code, e.g. +923001234567 or +1234567890)
USER_WHATSAPP_PHONE=

# -----------------------------------------------------------------------------
# 6. Moltbook AI Social Network (Optional)
# -----------------------------------------------------------------------------
# Automatically populated when registering on Moltbook via UI
MOLTBOOK_API_KEY=
